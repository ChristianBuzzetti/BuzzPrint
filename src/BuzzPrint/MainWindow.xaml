<Window x:Class="BuzzPrint.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:BuzzPrint" Style="{StaticResource {x:Type Window}}" TextOptions.TextFormattingMode="Display" Title="BuzzPrint" Width="1440" Height="900" MinWidth="860" MinHeight="560" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <!-- Capture card: thumbnail on the canvas, title and mono facts; the selected card takes the accent ring, tint and 3 px bar. -->
    <Style x:Key="CaptureCard" TargetType="ListBoxItem">
      <Setter Property="Margin" Value="0,0,14,14"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Focusable" Value="True"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Grid>
          <Border x:Name="Frame" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource FaintBorder}" BorderThickness="1" CornerRadius="{DynamicResource ControlRadius}"><ContentPresenter/></Border>
          <Border x:Name="Bar" Width="3" HorizontalAlignment="Left" Background="{DynamicResource Accent}" Visibility="Hidden"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource SurfaceRaised}"/><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource StrongBorder}"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource AccentTint}"/><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentRing}"/><Setter TargetName="Bar" Property="Visibility" Value="Visible"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <DockPanel>
    <!-- DBMON shell: topbar (wordmark, status dot, actions) with the neon edge at its foot, then the subbar (menus,
         actions) on 8 px hairlines. Boberto's 16:9 scene owns the right side of the whole band. -->
    <Grid DockPanel.Dock="Top" Background="{DynamicResource Header}">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition x:Name="BobertoColumn" Width="300"/></Grid.ColumnDefinitions>
      <DockPanel x:Name="HeaderLeft">
        <Border x:Name="HeaderBar" DockPanel.Dock="Top" Background="{DynamicResource Header}" BorderBrush="{DynamicResource TopbarRule}" BorderThickness="0,0,0,1" Padding="20,10,16,6">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <local:BobertoMark x:Name="BrandMark" Tile="{DynamicResource Accent}" Width="30" Height="30" Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="Boberto"/>
              <StackPanel x:Name="Wordmark" Orientation="Horizontal" VerticalAlignment="Center" Cursor="Hand" ToolTip="BuzzPrint" MouseLeftButtonUp="WordmarkClick"/>
              <Grid Width="12" Height="12" Margin="8,2,0,0" VerticalAlignment="Center"><Ellipse Width="12" Height="12" Fill="{DynamicResource OkGlow}"/><Ellipse x:Name="BrandDot" Width="6" Height="6" Fill="{DynamicResource Ok}"/></Grid>
              <Border x:Name="Subtitle" BorderBrush="{DynamicResource FaintBorder}" BorderThickness="1,0,0,0" Margin="16,2,0,2" Padding="14,0,0,0" VerticalAlignment="Center"><TextBlock Text="{local:T 'CAPTURAS · VIDEO · AUDIO · ANOTACIONES'}" FontFamily="{DynamicResource MonoFont}" FontSize="10" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/></Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Border x:Name="SearchBox" Width="300" Height="34" BorderThickness="1" BorderBrush="{DynamicResource FaintBorder}" Background="{DynamicResource Surface}" CornerRadius="{DynamicResource ControlRadius}" Padding="10,0,6,0">
                <DockPanel>
                  <Border DockPanel.Dock="Right" BorderThickness="1" BorderBrush="{DynamicResource FaintBorder}" Padding="5,0" VerticalAlignment="Center" CornerRadius="{DynamicResource ControlRadius}"><TextBlock Text="Ctrl F" FontFamily="{DynamicResource MonoFont}" FontSize="10" Foreground="{DynamicResource Muted}"/></Border>
                  <TextBlock DockPanel.Dock="Left" Style="{StaticResource GlyphText}" Text="&#xE721;" Foreground="{DynamicResource Muted}"/>
                  <Grid>
                    <TextBox x:Name="Search" BorderThickness="0" Background="Transparent" Padding="0,7" TextChanged="SearchChanged" ToolTip="{local:T 'Filtrar capturas por nombre o ventana'}"/>
                    <TextBlock Text="{local:T 'Buscar capturas…'}" IsHitTestVisible="False" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="2,0,0,0">
                      <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                  </Grid>
                </DockPanel>
              </Border>
              <Button x:Name="PersonalizeButton" Style="{StaticResource PillButton}" Click="PersonalizeClick" ToolTip="{local:T 'Personalizar: paleta, tipografía, interfaz y Boberto'}"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource GlyphText}" Text="&#xE713;" Margin="0,0,7,0"/><TextBlock x:Name="PersonalizeText" Text="{local:T 'Personalizar'}" VerticalAlignment="Center"/></StackPanel></Button>
            </StackPanel>
          </Grid>
        </Border>
        <Grid DockPanel.Dock="Top" Height="2" ClipToBounds="True"><Rectangle Fill="{DynamicResource EdgeBar}" Opacity="0.75"/><Rectangle x:Name="EdgeSweep"/></Grid>
        <Border BorderBrush="{DynamicResource StrongBorder}" BorderThickness="0,0,0,1" Background="{DynamicResource SubbarHairlines}">
          <DockPanel>
            <Menu x:Name="MainMenu" DockPanel.Dock="Top" Padding="16,8,16,0">
              <MenuItem Header="{local:T 'Captura'}" Tag="&#xE722;">
                <MenuItem x:Name="MenuCapture" Header="{local:T 'Región o ventana'}" Click="CaptureClick"/>
                <MenuItem x:Name="MenuFull" Header="{local:T 'Pantalla completa'}" Click="FullClick"/>
                <MenuItem x:Name="MenuDelayed" Header="{local:T 'Con demora'}" Click="DelayedClick"/>
                <Separator/>
                <MenuItem x:Name="MenuQuick" Header="{local:T 'Menú rápido'}" Click="QuickClick"/>
                <Separator/>
                <MenuItem Header="{local:T 'Salir'}" Click="ExitClick"/>
              </MenuItem>
              <MenuItem Header="{local:T 'Grabación'}" Tag="&#xE7C8;">
                <MenuItem x:Name="MenuRecord" Header="{local:T 'Grabar video'}" Click="RecordVideoClick"/>
                <MenuItem x:Name="MenuRecordAudio" Header="{local:T 'Grabar solo audio'}" Click="RecordAudioClick"/>
                <MenuItem x:Name="MenuStopRecord" Header="{local:T 'Detener grabación'}" Click="StopRecordClick" IsEnabled="False"/>
                <Separator/>
                <MenuItem Header="{local:T 'Ver grabaciones'}" Click="ShowRecordingsClick"/>
                <MenuItem Header="{local:T 'Abrir carpeta de grabaciones'}" Click="RecordFolderClick"/>
              </MenuItem>
              <MenuItem Header="{local:T 'Edición'}" Tag="&#xE70F;">
                <MenuItem Header="{local:T 'Copiar imagen'}" InputGestureText="Ctrl+C" Click="CopyClick"/>
                <MenuItem Header="{local:T 'Copiar como archivo'}" Click="CopyFileClick"/>
                <MenuItem Header="{local:T 'Editar y anotar'}" InputGestureText="Enter" Click="EditClick"/>
                <MenuItem Header="{local:T 'Renombrar'}" InputGestureText="F2" Click="RenameClick"/>
                <MenuItem Header="{local:T 'Fijar / soltar'}" InputGestureText="Ctrl+P" Click="PinClick"/>
                <Separator/>
                <MenuItem Header="{local:T 'Exportar a PowerPoint, Word o PDF…'}" InputGestureText="Ctrl+E" Click="ExportClick"/>
                <MenuItem Header="{local:T 'Copiar como una sola imagen'}" InputGestureText="Ctrl+Shift+C" Click="CopyStitchedClick"/>
                <Separator/>
                <MenuItem Header="{local:T 'Eliminar'}" InputGestureText="Supr" Click="DeleteClick"/>
              </MenuItem>
              <MenuItem Header="{local:T 'Biblioteca'}" Tag="&#xE8F1;">
                <MenuItem Header="{local:T 'Buscar'}" InputGestureText="Ctrl+F" Click="FocusSearchClick"/>
                <MenuItem Header="{local:T 'Seleccionar todo'}" InputGestureText="Ctrl+A" Click="SelectAllClick"/>
                <MenuItem Header="{local:T 'Seleccionar las de hoy'}" Click="SelectTodayClick"/>
                <MenuItem Header="{local:T 'Exportar las de hoy…'}" Click="ExportTodayClick"/>
                <Separator/>
                <MenuItem Header="{local:T 'Secciones'}" SubmenuOpened="SectionsMenuOpened"><MenuItem Header="…"/></MenuItem>
                <MenuItem Header="{local:T 'Mostrar en carpeta'}" Click="RevealClick"/>
                <MenuItem Header="{local:T 'Abrir carpeta de capturas'}" Click="FolderClick"/>
              </MenuItem>
              <MenuItem Header="{local:T 'Vista'}" Tag="&#xE890;">
                <MenuItem Header="{local:T 'Personalizar…'}" Click="PersonalizeClick"/>
                <Separator/>
                <MenuItem x:Name="ShowOptionsMenu" Header="{local:T 'Panel de opciones'}" IsCheckable="True" IsChecked="True" Click="OptionsToggleClick"/>
                <MenuItem x:Name="ShowBobertoMenu" Header="Boberto" IsCheckable="True" IsChecked="True" Click="BobertoToggleClick"/>
                <Separator/>
                <MenuItem Header="{local:T 'Idioma'}">
                  <MenuItem x:Name="LangEnMenu" Header="English" IsCheckable="True" Click="LangEnClick"/>
                  <MenuItem x:Name="LangEsMenu" Header="Español" IsCheckable="True" Click="LangEsClick"/>
                </MenuItem>
              </MenuItem>
              <MenuItem Header="{local:T 'Ayuda'}" Tag="&#xE897;"><MenuItem Header="{local:T 'Revisar componentes…'}" Click="ComponentsClick"/><MenuItem Header="{local:T 'Acerca de BuzzPrint'}" Click="AboutClick"/></MenuItem>
            </Menu>
            <Border Padding="{DynamicResource ToolbarPadding}">
              <StackPanel x:Name="CommandToolbar" Orientation="Horizontal" ClipToBounds="True">
                <Button x:Name="CaptureButton" Background="{DynamicResource Accent}" Foreground="{DynamicResource OnAccent}" BorderBrush="{DynamicResource Accent}" Click="CaptureClick" Margin="0,0,1,0" ToolTip="{local:T 'Arrastrá una región o hacé clic en una ventana'}"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource GlyphText}" Text="&#xE722;" FontSize="12" Margin="0,0,7,0"/><TextBlock Text="{local:T 'Capturar'}" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock x:Name="CaptureKeyHint" Text="PrtSc" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource SmallFontSize}" Opacity="0.75" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                <Button x:Name="CaptureMenuButton" Click="CaptureMenuClick" Background="{DynamicResource Accent}" Foreground="{DynamicResource OnAccent}" BorderBrush="{DynamicResource Accent}" Padding="7,0" Margin="0,0,8,0" ToolTip="{local:T 'Otras formas de capturar: pantalla completa, con demora'}"><TextBlock Style="{StaticResource GlyphText}" Text="&#xE70D;" FontSize="10" Margin="0"/></Button>
                <Button x:Name="RecordButton" Click="RecordVideoClick" Margin="0,0,1,0" ToolTip="{local:T 'Grabar video de una región, ventana o pantalla'}"><StackPanel Orientation="Horizontal"><Grid Width="12" Height="12" Margin="0,0,7,0" VerticalAlignment="Center"><Ellipse x:Name="RecordDot" Width="10" Height="10" Fill="#F43F5E"/><Rectangle x:Name="RecordStopGlyph" Width="9" Height="9" Fill="#F43F5E" Visibility="Collapsed"/></Grid><TextBlock x:Name="RecordText" Text="{local:T 'Grabar'}" VerticalAlignment="Center"/><TextBlock x:Name="RecordKeyHint" Text="Ctrl Alt R" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource SmallFontSize}" Opacity="0.6" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                <Button x:Name="RecordMenuButton" Click="RecordMenuClick" Padding="7,0" Margin="0,0,8,0" ToolTip="{local:T 'Grabar video o solo audio'}"><TextBlock Style="{StaticResource GlyphText}" Text="&#xE70D;" FontSize="10" Margin="0"/></Button>
                <Button Click="QuickClick" ToolTip="{local:T 'Menú rápido de capturas · Ctrl+Alt+V'}"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource GlyphText}" Text="&#xE8FD;" FontSize="12" Margin="0,0,7,0"/><TextBlock x:Name="QuickText" Text="{local:T 'Menú rápido'}" VerticalAlignment="Center"/></StackPanel></Button>
                <Button x:Name="ExportButton" Click="ExportClick" Margin="8,0,0,0" ToolTip="{local:T 'Exportar las capturas elegidas, en orden, a PowerPoint, Word, PDF o una sola imagen · Ctrl+E'}"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource GlyphText}" Text="&#xEDE1;" FontSize="12" Margin="0,0,7,0"/><TextBlock x:Name="ExportText" Text="{local:T 'Exportar'}" VerticalAlignment="Center"/></StackPanel></Button>
                <Border Width="1" Height="22" Background="{DynamicResource FaintBorder}" Margin="6,0,10,0"/>
                <Button Click="CopyClick" ToolTip="{local:T 'Copiar imagen · Ctrl+C'}" Padding="9,0"><TextBlock Style="{StaticResource GlyphText}" Text="&#xE8C8;" FontSize="13" Margin="0"/></Button>
                <Button Click="EditClick" ToolTip="{local:T 'Editar y anotar · Enter'}" Padding="9,0"><TextBlock Style="{StaticResource GlyphText}" Text="&#xE70F;" FontSize="13" Margin="0"/></Button>
                <Button Click="RenameClick" ToolTip="{local:T 'Renombrar · F2'}" Padding="9,0"><TextBlock Style="{StaticResource GlyphText}" Text="&#xE8AC;" FontSize="13" Margin="0"/></Button>
                <Button Click="PinClick" ToolTip="{local:T 'Fijar arriba · Ctrl+P'}" Padding="9,0"><TextBlock Style="{StaticResource GlyphText}" Text="&#xE718;" FontSize="13" Margin="0"/></Button>
                <Button Click="DeleteClick" ToolTip="{local:T 'Eliminar · Supr'}" Padding="9,0"><TextBlock Style="{StaticResource GlyphText}" Text="&#xE74D;" FontSize="13" Margin="0"/></Button>
                <Border Width="1" Height="22" Background="{DynamicResource FaintBorder}" Margin="6,0,10,0"/>
                <Button x:Name="EditorButton" Click="EditClick" ToolTip="{local:T 'Abrir el editor'}"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource GlyphText}" Text="&#xE7E6;" FontSize="12" Margin="0,0,7,0"/><TextBlock x:Name="EditorText" Text="Editor" VerticalAlignment="Center"/></StackPanel></Button>
                <Button x:Name="FolderButton" Click="FolderClick" ToolTip="{local:T 'Abrir la carpeta de capturas'}"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource GlyphText}" Text="&#xE838;" FontSize="12" Margin="0,0,7,0"/><TextBlock x:Name="FolderText" Text="{local:T 'Carpeta'}" VerticalAlignment="Center"/></StackPanel></Button>
              </StackPanel>
            </Border>
          </DockPanel>
        </Border>
      </DockPanel>
      <Canvas Grid.Column="1" ClipToBounds="True">
        <Border x:Name="BobertoPanel" Background="{DynamicResource Header}" BorderBrush="{DynamicResource FaintBorder}" BorderThickness="1,0,0,1">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Width="34" Background="{DynamicResource Header}">
              <Button Style="{StaticResource IconButton}" Content="&#xE771;" Click="BobertoClick" ToolTip="{local:T 'Personalizar a Boberto: gestos, ropa, accesorios, fondos y bordes'}"/>
              <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" Click="BobertoHideClick" ToolTip="{local:T 'Ocultar a Boberto · Vista → Boberto lo vuelve a mostrar'}"/>
            </StackPanel>
            <ContentControl x:Name="BobertoHost" Focusable="False"/>
          </DockPanel>
        </Border>
      </Canvas>
    </Grid>
    <!-- .bzp-footer colophon: accent double rule above, mono status line. -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Header}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top"><Border Height="1" Background="{DynamicResource AccentWeak}"/><Border Height="1" Margin="0,2,0,0" Background="{DynamicResource AccentRule}"/><Border Height="1" Margin="0,1,0,0" Background="{DynamicResource TopbarGlow}"/></StackPanel>
        <Grid Margin="16,6,14,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="StatusText" Text="{local:T 'Listo'}" Foreground="{DynamicResource Muted}" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource SmallFontSize}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="SelectionText" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource SmallFontSize}" Foreground="{DynamicResource Muted}" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <Border BorderBrush="{DynamicResource FaintBorder}" BorderThickness="1,0,0,0" Margin="0,2,2,2"/>
            <Button Style="{StaticResource StatusSegment}" Click="CaptureClick" ToolTip="{local:T 'Capturar región o ventana'}"><StackPanel Orientation="Horizontal"><TextBlock x:Name="StatusCaptureKey" Text="PrtSc" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" Margin="0,0,6,0"/><TextBlock Text="{local:T 'capturar'}" Foreground="{DynamicResource Muted}"/></StackPanel></Button>
            <Button Style="{StaticResource StatusSegment}" Click="RecordVideoClick" ToolTip="{local:T 'Grabar video'}"><StackPanel Orientation="Horizontal"><TextBlock x:Name="StatusRecordKey" Text="Ctrl+Alt+R" Foreground="{DynamicResource Ink}" FontWeight="SemiBold" Margin="0,0,6,0"/><TextBlock x:Name="StatusRecordText" Text="{local:T 'grabar'}" Foreground="{DynamicResource Muted}"/></StackPanel></Button>
            <Button Style="{StaticResource StatusSegment}" Click="QuickClick" ToolTip="{local:T 'Menú rápido'}"><StackPanel Orientation="Horizontal"><TextBlock x:Name="StatusPickKey" Text="Ctrl+Alt+V" Foreground="{DynamicResource Ink}" FontWeight="SemiBold" Margin="0,0,6,0"/><TextBlock Text="{local:T 'menú'}" Foreground="{DynamicResource Muted}"/></StackPanel></Button>
            <Border BorderBrush="{DynamicResource FaintBorder}" BorderThickness="1,0,0,0" Margin="8,2,4,2"/>
            <Button Style="{StaticResource StatusSegment}" Click="FolderClick" ToolTip="{local:T 'Abrir la carpeta de capturas'}"><StackPanel Orientation="Horizontal"><TextBlock Text="DIR" Foreground="{DynamicResource Muted}" Margin="0,0,6,0"/><TextBlock x:Name="FolderStatus" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/></StackPanel></Button>
          </StackPanel>
        </Grid>
      </DockPanel>
    </Border>
    <Grid x:Name="WorkArea" Margin="16,12,16,12">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="OptionsColumn" Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ContentControl x:Name="OptionsPanel" Style="{StaticResource NeoCard}" Margin="0,0,14,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="18,16,18,16">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><TextBlock Text="&#x259A;" Foreground="{DynamicResource Accent}" FontSize="10" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Style="{StaticResource SectionLabel}" Text="{local:T 'DESPUÉS DE CAPTURAR'}"/></StackPanel>
            <Border BorderBrush="{DynamicResource AccentRowRule}" BorderThickness="0,0,0,1" Padding="0,8,0,10"><DockPanel><CheckBox x:Name="CopyToggle" DockPanel.Dock="Right" Margin="12,0,0,0" Click="OptionChanged"/><StackPanel><TextBlock Text="{local:T 'Copiar al portapapeles'}" FontWeight="SemiBold"/><TextBlock Text="{local:T 'Lista para pegar con Ctrl+V'}" Foreground="{DynamicResource Muted}" FontSize="{DynamicResource SmallFontSize}" TextWrapping="Wrap"/></StackPanel></DockPanel></Border>
            <Border BorderBrush="{DynamicResource AccentRowRule}" BorderThickness="0,0,0,1" Padding="0,10"><DockPanel><CheckBox x:Name="EditorToggle" DockPanel.Dock="Right" Margin="12,0,0,0" Click="OptionChanged"/><StackPanel><TextBlock Text="{local:T 'Abrir en el editor'}" FontWeight="SemiBold"/><TextBlock Text="{local:T 'Para anotar apenas capturás'}" Foreground="{DynamicResource Muted}" FontSize="{DynamicResource SmallFontSize}" TextWrapping="Wrap"/></StackPanel></DockPanel></Border>
            <Border BorderBrush="{DynamicResource AccentRowRule}" BorderThickness="0,0,0,1" Padding="0,10"><DockPanel><CheckBox x:Name="KeepOriginalToggle" DockPanel.Dock="Right" Margin="12,0,0,0" Click="OptionChanged"/><StackPanel><TextBlock Text="{local:T 'Conservar la original al editar'}" FontWeight="SemiBold"/><TextBlock Text="{local:T 'La versión anotada se guarda como otra captura'}" Foreground="{DynamicResource Muted}" FontSize="{DynamicResource SmallFontSize}" TextWrapping="Wrap"/></StackPanel></DockPanel></Border>
            <Border BorderBrush="{DynamicResource AccentRowRule}" BorderThickness="0,0,0,1" Padding="0,10"><DockPanel><CheckBox x:Name="PasteToggle" DockPanel.Dock="Right" Margin="12,0,0,0" Click="OptionChanged"/><StackPanel><TextBlock Text="{local:T 'Pegar al elegir del menú'}" FontWeight="SemiBold"/><TextBlock Text="{local:T 'El menú rápido pega en la ventana donde estabas'}" Foreground="{DynamicResource Muted}" FontSize="{DynamicResource SmallFontSize}" TextWrapping="Wrap"/></StackPanel></DockPanel></Border>
            <Border Padding="0,10,0,4"><DockPanel><CheckBox x:Name="StartupToggle" DockPanel.Dock="Right" Margin="12,0,0,0" Click="OptionChanged"/><StackPanel><TextBlock Text="{local:T 'Iniciar con Windows'}" FontWeight="SemiBold"/><TextBlock Text="{local:T 'Arranca en la bandeja del sistema'}" Foreground="{DynamicResource Muted}" FontSize="{DynamicResource SmallFontSize}" TextWrapping="Wrap"/></StackPanel></DockPanel></Border>
            <StackPanel Orientation="Horizontal" Margin="0,22,0,10"><TextBlock Text="&#x259A;" Foreground="{DynamicResource Accent}" FontSize="10" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Style="{StaticResource SectionLabel}" Text="{local:T 'GRABACIÓN'}"/></StackPanel>
            <Border BorderBrush="{DynamicResource AccentRowRule}" BorderThickness="0,0,0,1" Padding="0,8,0,10"><DockPanel><CheckBox x:Name="SystemAudioToggle" DockPanel.Dock="Right" Margin="12,0,0,0" Click="OptionChanged"/><StackPanel><TextBlock Text="{local:T 'Audio del sistema'}" FontWeight="SemiBold"/><TextBlock Text="{local:T 'Lo que suena en la PC: videos, llamadas, alertas'}" Foreground="{DynamicResource Muted}" FontSize="{DynamicResource SmallFontSize}" TextWrapping="Wrap"/></StackPanel></DockPanel></Border>
            <Border BorderBrush="{DynamicResource AccentRowRule}" BorderThickness="0,0,0,1" Padding="0,10"><DockPanel><CheckBox x:Name="MicToggle" DockPanel.Dock="Right" Margin="12,0,0,0" Click="OptionChanged"/><StackPanel><TextBlock Text="{local:T 'Micrófono'}" FontWeight="SemiBold"/><TextBlock Text="{local:T 'Tu voz, con el micrófono predeterminado de Windows'}" Foreground="{DynamicResource Muted}" FontSize="{DynamicResource SmallFontSize}" TextWrapping="Wrap"/></StackPanel></DockPanel></Border>
            <Border Padding="0,10,0,4"><DockPanel><CheckBox x:Name="CursorToggle" DockPanel.Dock="Right" Margin="12,0,0,0" Click="OptionChanged"/><StackPanel><TextBlock Text="{local:T 'Mostrar el cursor'}" FontWeight="SemiBold"/><TextBlock Text="{local:T 'El puntero del mouse aparece en el video'}" Foreground="{DynamicResource Muted}" FontSize="{DynamicResource SmallFontSize}" TextWrapping="Wrap"/></StackPanel></DockPanel></Border>
            <StackPanel Orientation="Horizontal" Margin="0,22,0,10"><TextBlock Text="&#x259A;" Foreground="{DynamicResource Accent}" FontSize="10" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Style="{StaticResource SectionLabel}" Text="{local:T 'ATAJOS'}"/></StackPanel>
            <ItemsControl x:Name="ShortcutList">
              <ItemsControl.ItemTemplate><DataTemplate>
                <DockPanel Margin="0,0,0,8">
                  <Border DockPanel.Dock="Left" MinWidth="96" Margin="0,0,12,0" HorizontalAlignment="Left"><Border HorizontalAlignment="Left" BorderThickness="1" BorderBrush="{DynamicResource StrongBorder}" Background="{DynamicResource Canvas}" Padding="7,2" CornerRadius="{DynamicResource ControlRadius}"><TextBlock Text="{Binding Key}" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource SmallFontSize}" Foreground="{DynamicResource Ink}"/></Border></Border>
                  <TextBlock Text="{Binding Text}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Margin="0,18,0,10"><TextBlock Text="&#x259A;" Foreground="{DynamicResource Accent}" FontSize="10" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Style="{StaticResource SectionLabel}" Text="{local:T 'ALMACENAMIENTO'}"/></StackPanel>
            <TextBlock Text="{local:T 'Imágenes'}" FontWeight="SemiBold" Margin="0,0,0,3"/>
            <TextBlock x:Name="StoragePath" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource SmallFontSize}" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
              <Button Click="ChangeCaptureFolderClick" Margin="0,0,6,0" ToolTip="{local:T 'Elegir dónde se guardan las capturas'}"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource GlyphText}" Text="&#xE8DA;" FontSize="12" Margin="0,0,7,0"/><TextBlock Text="{local:T 'Cambiar…'}" VerticalAlignment="Center"/></StackPanel></Button>
              <Button Click="FolderClick" ToolTip="{local:T 'Abrir la carpeta de capturas'}"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource GlyphText}" Text="&#xE838;" FontSize="12" Margin="0,0,7,0"/><TextBlock Text="{local:T 'Abrir'}" VerticalAlignment="Center"/></StackPanel></Button>
            </StackPanel>
            <TextBlock Text="{local:T 'Videos y audio'}" FontWeight="SemiBold" Margin="0,0,0,3"/>
            <TextBlock x:Name="RecordPath" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource SmallFontSize}" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal">
              <Button Click="ChangeRecordFolderClick" Margin="0,0,6,0" ToolTip="{local:T 'Elegir dónde se guardan las grabaciones'}"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource GlyphText}" Text="&#xE8DA;" FontSize="12" Margin="0,0,7,0"/><TextBlock Text="{local:T 'Cambiar…'}" VerticalAlignment="Center"/></StackPanel></Button>
              <Button Click="RecordFolderClick" ToolTip="{local:T 'Abrir la carpeta de grabaciones'}"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource GlyphText}" Text="&#xE838;" FontSize="12" Margin="0,0,7,0"/><TextBlock Text="{local:T 'Abrir'}" VerticalAlignment="Center"/></StackPanel></Button>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </ContentControl>
      <ContentControl Grid.Column="1" Style="{StaticResource NeoCard}">
        <DockPanel>
          <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource FaintBorder}" BorderThickness="0,0,0,1" Padding="12,12,16,10">
            <DockPanel>
              <TextBlock x:Name="CountText" DockPanel.Dock="Right" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource SmallFontSize}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
              <TabControl x:Name="Filters" Padding="0" SelectionChanged="FilterChanged" BorderBrush="{DynamicResource Rule}">
                <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource TabIcon}" Text="&#xE8B9;"/><TextBlock Text="{local:T 'Todas'}" VerticalAlignment="Center"/></StackPanel></TabItem.Header></TabItem>
                <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource TabIcon}" Text="&#xE787;"/><TextBlock Text="{local:T 'Hoy'}" VerticalAlignment="Center"/></StackPanel></TabItem.Header></TabItem>
                <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource TabIcon}" Text="&#xE718;"/><TextBlock Text="{local:T 'Fijadas'}" VerticalAlignment="Center"/></StackPanel></TabItem.Header></TabItem>
                <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource TabIcon}" Text="&#xE70F;"/><TextBlock Text="{local:T 'Editadas'}" VerticalAlignment="Center"/></StackPanel></TabItem.Header></TabItem>
                <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource TabIcon}" Text="&#xE714;"/><TextBlock Text="{local:T 'Grabaciones'}" VerticalAlignment="Center"/></StackPanel></TabItem.Header></TabItem>
              </TabControl>
            </DockPanel>
          </Border>
          <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource FaintBorder}" BorderThickness="0,0,0,1" Padding="14,8,16,8">
            <DockPanel>
              <Button DockPanel.Dock="Right" Click="SectionsButtonClick" ToolTip="{local:T 'Crear, renombrar o eliminar secciones'}"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource GlyphText}" Text="&#xE8FD;" FontSize="11" Margin="0,0,7,0"/><TextBlock Text="{local:T 'Secciones'}" VerticalAlignment="Center"/><TextBlock Style="{StaticResource GlyphText}" Text="&#xE70D;" FontSize="9" Margin="8,0,0,0"/></StackPanel></Button>
              <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="{local:T 'DÍA'}" Style="{StaticResource SectionLabel}" Margin="0,0,8,0"/><ComboBox x:Name="DayFilter" Width="190" Margin="0,0,18,0" SelectionChanged="SubFilterChanged"/>
                <TextBlock Text="{local:T 'SECCIÓN'}" Style="{StaticResource SectionLabel}" Margin="0,0,8,0"/><ComboBox x:Name="SectionFilter" Width="200" Margin="0,0,18,0" SelectionChanged="SubFilterChanged"/>
                <TextBlock Text="{local:T 'AGRUPAR'}" Style="{StaticResource SectionLabel}" Margin="0,0,8,0"/><ComboBox x:Name="GroupByBox" Width="150" SelectionChanged="SubFilterChanged"/>
              </WrapPanel>
            </DockPanel>
          </Border>
          <Grid>
            <ListBox x:Name="Library" ContextMenuOpening="LibraryMenuOpening" Background="Transparent" BorderThickness="0" Padding="14,14,0,0" SelectionMode="Extended" ItemContainerStyle="{StaticResource CaptureCard}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="LibraryDoubleClick" SelectionChanged="LibrarySelectionChanged" PreviewMouseLeftButtonDown="LibraryMouseDown" PreviewMouseMove="LibraryMouseMove" VirtualizingPanel.IsVirtualizing="False">
              <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
              <ListBox.GroupStyle>
                <GroupStyle>
                  <GroupStyle.ContainerStyle>
                    <Style TargetType="GroupItem">
                      <Setter Property="Template"><Setter.Value>
                        <ControlTemplate TargetType="GroupItem">
                          <DockPanel Margin="0,0,14,6">
                            <ToggleButton x:Name="Fold" ContextMenuOpening="GroupHeaderMenu" ContextMenu="{x:Null}" DockPanel.Dock="Top" IsChecked="True" Cursor="Hand" Focusable="False" Margin="0,2,0,8">
                              <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                                <Border Background="Transparent" BorderBrush="{DynamicResource AccentRowRule}" BorderThickness="0,0,0,1" Padding="2,4,2,6">
                                  <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="Chevron" Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="&#x259A;" Foreground="{DynamicResource Accent}" FontSize="10" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ItemCount}" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource SmallFontSize}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                  </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="False"><Setter TargetName="Chevron" Property="Text" Value="&#xE76C;"/></Trigger></ControlTemplate.Triggers>
                              </ControlTemplate></ToggleButton.Template>
                            </ToggleButton>
                            <ItemsPresenter x:Name="Items"/>
                          </DockPanel>
                          <ControlTemplate.Triggers><Trigger SourceName="Fold" Property="IsChecked" Value="False"><Setter TargetName="Items" Property="Visibility" Value="Collapsed"/></Trigger></ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value></Setter>
                    </Style>
                  </GroupStyle.ContainerStyle>
                </GroupStyle>
              </ListBox.GroupStyle>
              <ListBox.ContextMenu>
                <ContextMenu>
                  <MenuItem x:Name="CtxCopy" Header="{local:T 'Copiar imagen'}" InputGestureText="Ctrl+C" Click="CopyClick"/>
                  <MenuItem Header="{local:T 'Copiar como archivo'}" Click="CopyFileClick"/>
                  <MenuItem x:Name="CtxEdit" Header="{local:T 'Editar y anotar'}" InputGestureText="Enter" Click="EditClick"/>
                  <MenuItem Header="{local:T 'Renombrar'}" InputGestureText="F2" Click="RenameClick"/>
                  <MenuItem Header="{local:T 'Fijar / soltar'}" InputGestureText="Ctrl+P" Click="PinClick"/>
                  <MenuItem Header="{local:T 'Mostrar en carpeta'}" Click="RevealClick"/>
                  <Separator/>
                  <MenuItem x:Name="CtxSection" Header="{local:T 'Mover a sección'}"/>
                  <MenuItem x:Name="CtxExport" Header="{local:T 'Exportar a PowerPoint, Word o PDF…'}" InputGestureText="Ctrl+E" Click="ExportClick"/>
                  <MenuItem x:Name="CtxStitch" Header="{local:T 'Copiar como una sola imagen'}" InputGestureText="Ctrl+Shift+C" Click="CopyStitchedClick"/>
                  <Separator/>
                  <MenuItem Header="{local:T 'Eliminar'}" InputGestureText="Supr" Click="DeleteClick" Foreground="{DynamicResource ErrorInk}"/>
                </ContextMenu>
              </ListBox.ContextMenu>
              <ListBox.ItemTemplate><DataTemplate>
                <StackPanel Width="{Binding CardWidth}">
                  <Grid Margin="8,8,8,0" Height="{Binding ThumbHeight}" Background="{DynamicResource Canvas}">
                    <Image Source="{Binding Thumb}" Stretch="Uniform" Margin="6" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Visibility="{Binding NoThumbVisibility}" Text="{Binding KindGlyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="34" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Border Visibility="{Binding PlayVisibility}" Width="40" Height="40" CornerRadius="20" Background="#99000000" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,0"/></Border>
                    <Border Visibility="{Binding KindVisibility}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6" Background="{DynamicResource Header}" BorderBrush="{DynamicResource AccentCardRing}" BorderThickness="1" Padding="6,1" CornerRadius="{DynamicResource ControlRadius}"><TextBlock Text="{Binding KindText}" FontFamily="{DynamicResource MonoFont}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Accent}"/></Border>
                    <Border Visibility="{Binding PinnedVisibility}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Background="{DynamicResource Accent}" Padding="6,1" CornerRadius="{DynamicResource ControlRadius}"><TextBlock Text="{local:T 'FIJADA'}" FontFamily="{DynamicResource MonoFont}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource OnAccent}"/></Border>
                    <Border Visibility="{Binding EditedVisibility}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" Background="{DynamicResource Header}" BorderBrush="{DynamicResource AccentCardRing}" BorderThickness="1" Padding="6,1" CornerRadius="{DynamicResource ControlRadius}"><TextBlock Text="{local:T 'ANOTADA'}" FontFamily="{DynamicResource MonoFont}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Accent}"/></Border>
                  </Grid>
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="12,10,12,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Ink}"/>
                  <TextBlock Text="{Binding Meta}" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource SmallFontSize}" Foreground="{DynamicResource Muted}" Margin="12,3,12,12" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
              <ContentControl x:Name="EmptyBoberto" Width="300" Height="230" Focusable="False" ToolTip="Boberto"/>
              <TextBlock x:Name="EmptyTitle" Text="{local:T 'Todavía no hay capturas'}" FontSize="{DynamicResource SectionFontSize}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4"/>
              <TextBlock x:Name="EmptyHint" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center"/>
            </StackPanel>
          </Grid>
        </DockPanel>
      </ContentControl>
    </Grid>
  </DockPanel>
</Window>
